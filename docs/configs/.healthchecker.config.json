{
  "app_name": "Health Checker",
  "version": "v1.0",
  "num_workers": 10,
  "auth_clients": [
    {
      "url": "https://auth.example.com",
      "client_id": "your-client-id",
      "client_secret": "your-client-secret",
      "grant_type": "client_credentials",
      "applications": [
        {
          "app_name": "App One",
          "app_url": "https://app-one.example.com/health",
          "recipients": ["admin@example.com"],
          "check_interval_seconds": 20
        },
        {
          "app_name": "App Two",
          "app_url": "https://app-two.example.com/health",
          "recipients": ["dev@example.com"],
          "check_interval_seconds": 30
        }
      ]
    },
    {
      "url": "https://auth2.example.com",
      "client_id": "another-client-id",
      "client_secret": "another-client-secret",
      "grant_type": "client_credentials",
      "applications": [
        {
          "app_name": "App Three",
          "app_url": "https://app-three.example.com/health",
          "recipients": ["team@example.com"],
          "check_interval_seconds": 15
        }
      ]
    }
  ]
}
