Hallo,<br>
<br>
<strong>HealthChecker : <br><br> </strong>
{{ range $key, $value := . }}
    <strong>Info : </strong>{{.Name}} <br>
    <strong>Status : </strong>{{.Status}}<br>
    <strong>Error : </strong>{{if .Error}} {{.Error}} {{else}} Not Found {{end}}.<br>
    <strong>Details : </strong>{{if .Details}} {{range $key, $value := .Details}} {{range $k, $v := $value}} {{$k}} {{$v}} <br>{{end}}{{end}}
{{else}} Not Found {{end}}<br>
<hr style="width:50%;text-align:left;margin-left:0">
<br>
{{end}}